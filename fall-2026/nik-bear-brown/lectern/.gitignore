# Lectern: the full run files stay on the machine that made them. Only the small delta is published
# (see publish_delta.py). Files already tracked from earlier runs stay tracked.
runs/*/all-jobs-*
runs/*/jobs-of-interest-*
runs/*/quality-report-*
runs/*/raw/
raw/
monitor.db
__pycache__/
# big-four ad text and run logs stay local
runs/text/
runs/logs/
*.log
runs/posted-to-discord.json
runs/posted-labs-to-discord.json
runs/posted-games-to-discord.json
runs/posted-consulting-to-discord.json
runs/*/consulting-jobs-*
runs/*/consulting-raw/
# lab outreach records name people and may hold email addresses: local only, never committed
labs/
lab-records/
# speaker leads: the leads file is rebuilt from targets.json; the people records name people and stay local (CLAUDE.md Rule 10)
runs/posted-speakers-to-discord.json
runs/*/speakers-leads-*
speaker-records/
