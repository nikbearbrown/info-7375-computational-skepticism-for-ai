# Lectern: the full run files stay on the machine that made them. Only the small delta is published
# (see publish_delta.py). Files already tracked from earlier runs stay tracked.
runs/*/all-jobs-*
runs/*/jobs-of-interest-*
runs/*/quality-report-*
runs/*/raw/
raw/
monitor.db
__pycache__/
# big-four ad text and run logs stay local
runs/text/
runs/logs/
*.log
runs/posted-to-discord.json
runs/posted-labs-to-discord.json
runs/posted-games-to-discord.json
runs/posted-consulting-to-discord.json
runs/*/consulting-jobs-*
runs/*/consulting-raw/
# lab outreach records name people and may hold email addresses: local only, never committed
labs/
lab-records/
# speaker leads: the leads file is rebuilt from targets.json; the people records name people and stay local (CLAUDE.md Rule 10)
runs/posted-speakers-to-discord.json
runs/*/speakers-leads-*
speaker-records/
# federal-508 channel (CLAUDE.md Rule 11): the postings file and the posted-ids memory are rebuilt/local
runs/posted-federal508-to-discord.json
runs/*/federal508-jobs-*
runs/*/federal508-raw/
# SAM.gov contract-opportunities extract (about 213 MB, refreshed nightly), what has been seen, and the report: local
runs/sam-cache/
runs/sam-seen*.json
runs/*/sam-opportunities-*
runs/*/sam-setaside-*
# USAspending prime-contractor leads (companies, from the government's open spending data): local
runs/*/usaspending-*
# California school-district lead list: the raw file, the lists, and the names a person asked to leave out are local
runs/ca-districts-cache/
runs/*/ca-school-district-leads-*
runs/lead-exclusions.txt
# files a person downloaded by hand in a browser for the lead lists (sources that do not let a script fetch them): local
runs/manual-downloads/
