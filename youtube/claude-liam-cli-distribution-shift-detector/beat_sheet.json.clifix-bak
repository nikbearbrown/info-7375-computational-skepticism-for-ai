    {
      "beat_id": "B01",
      "act": "PROBLEM — why care",
      "role_note": "the problem, the stakes — BEFORE the CLI",
      "narration_text": "A credit scoring model trained in Q1 is deployed in Q4. The input distribution has shifted — customer age profiles changed, income distributions moved, a macroeconomic shock altered the feature correlations. The model's accuracy on the new population is down twelve points. No one noticed because no one was monitoring the inputs. Population Stability Index is the standard signal: it measures how much the input distribution has drifted from what the model was trained on, bucket by bucket. A PSI above point-two triggers a retrain. This video builds the monitor.",
      "visual_intent": "title card: 'input distribution shifted — model did not know'; PROBLEM beat, no terminal",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "command": "input distribution shifted — model did not know",
            "topic": "COMPUTATIONAL SKEPTICISM",
            "segment": "Distribution Shift, taken apart.",
            "greeting": "",
            "runningText": "framing the problem…",
            "output": [],
            "folderLabel": "@NikBearBrown",
            "modelLabel": "Fable 5",
            "effortLabel": "High"
          },
          "rendered": {
