    {
      "beat_id": "B06",
      "act": "SUMMARY",
      "role_note": "the lesson — one beat",
      "narration_text": "The per-feature PSI sweep identifies features three, seven, and twelve as the drift drivers — the ones you artificially shifted. The model degraded on those features and had no way to report it. The lesson: PSI is not a model metric — it is an input health metric. You run it on the data, not on the predictions. Predictions can look stable while inputs are already broken.",
      "visual_intent": "recap card: per-feature PSI ranked table; 'monitor inputs, not just predictions'",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "lesson.md",
            "code": "# KEY LESSON\n#\n# The per-feature PSI sweep identifies features three, seven, and twelve\n# as the drift drivers — the ones you artificially shifted. The model\n# degraded on those features and had no way to report it. The lesson:\n# PSI is not a model metric — it is an input health metric.\n#\n# → monitor inputs, not just predictions",
            "sparkLine": "Distribution Shift, taken apart."
