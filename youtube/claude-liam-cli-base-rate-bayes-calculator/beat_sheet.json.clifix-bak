    {
      "beat_id": "B06",
      "act": "SUMMARY",
      "role_note": "the lesson — one beat",
      "narration_text": "At two-percent prevalence with ninety-percent sensitivity, you need a specificity of ninety-four percent before PPV clears ten percent. The sepsis model published at eighty-two percent never makes it. The lesson: sensitivity and specificity are properties of the test. PPV is a property of the deployment context. They are not interchangeable, and the base rate is not optional information.",
      "visual_intent": "recap card: 'test properties vs deployment context'; specificity threshold result",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "lesson.md",
            "code": "# KEY LESSON\n#\n# At two-percent prevalence with ninety-percent sensitivity, you need a\n# specificity of ninety-four percent before PPV clears ten percent. The\n# sepsis model published at eighty-two percent never makes it. The\n# lesson: sensitivity and specificity are properties of the test.\n#\n# → specificity threshold result",
            "sparkLine": "Base Rate Neglect, taken apart."
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": ""
          }
        }
      },
      "estimated_duration_s": 12,
      "audio_file": "mp3/beat-B06.mp3",
      "actual_duration_s": 20.44,
      "build": {
        "status": "VIDEO",
        "src": "media/B06.mp4",
        "filled_by": "media",
        "at": "2026-07-19T16:44:14"
      }
    },
    {
      "beat_id": "B07",
      "act": "NEXT STEPS",
      "role_note": "what to do next",
      "narration_text": "Your move: find the base rate of the condition your model detects in the real deployment population — not the training set. Plug it into the Bayes PPV formula with the published sensitivity and specificity. If PPV is under twenty percent, your alert system needs a prevalence-enriched pre-filter before it goes clinical.",
      "visual_intent": "next-steps card: 1) find real deployment base rate, 2) compute PPV, 3) add pre-filter if PPV < 20%",
