    {
      "beat_id": "B06",
      "act": "SUMMARY",
      "role_note": "the lesson — one beat",
      "narration_text": "A well-anchored system prompt reduces variance. The agreement rate rises. But it does not go to one hundred percent — because the model is a probability distribution, not a lookup table. The lesson: prompt sensitivity is not a prompt engineering problem — it is a deployment risk measurement. For any high-stakes application, measure the agreement rate before shipping and set a minimum threshold it must clear.",
      "visual_intent": "recap card: agreement rate before and after system prompt; 'LLM = probability distribution, not lookup table'",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "lesson.md",
            "code": "# KEY LESSON\n#\n# A well-anchored system prompt reduces variance. The agreement rate\n# rises. But it does not go to one hundred percent — because the model\n# is a probability distribution, not a lookup table.\n#\n# → LLM = probability distribution, not lookup table",
            "sparkLine": "Prompt Sensitivity, taken apart."
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": ""
          }
        }
      },
      "estimated_duration_s": 12,
      "audio_file": "mp3/beat-B06.mp3",
      "actual_duration_s": 20.03,
      "build": {
        "status": "VIDEO",
        "src": "media/B06.mp4",
