    {
      "beat_id": "B01",
      "act": "PROBLEM — why care",
      "role_note": "the stakes BEFORE the build begins — no terminal yet",
      "narration_text": "You trained a classifier this week. It prints confidence scores. You have never checked whether those confidence scores mean anything. A model that says ninety-four percent and is right fifty-six percent of the time is not a reliable model — it's a confident wrong one. The reliability diagram makes your own overconfidence visible. And the shifted slice — the high-value subgroup the model matters most for — is where the decorative number gets caught.",
      "visual_intent": "title card: 'your model says 94% — does it mean 94%?'; PROBLEM beat, no terminal yet",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "command": "your model says 94% — does it mean 94%?",
            "topic": "COMPUTATIONAL SKEPTICISM",
            "segment": "Reliability Diagram on Your Own Model, taken apart.",
            "greeting": "",
            "runningText": "framing the problem…",
            "output": [],
