    {
      "beat_id": "B06",
      "act": "SUMMARY",
      "role_note": "the lesson — one beat",
      "narration_text": "Temperature scaling closes the in-distribution ECE gap — the curve moves to the diagonal. But on the shifted slice, ECE barely moves. Calibration on your training distribution does not survive a distribution shift. The reliability diagram is the instrument that makes your own overconfidence visible; the shifted slice is the test that exposes where it hides; and the prediction lock is the tool that prevents you from editing the guess after you see the result.",
      "visual_intent": "recap card: 'temperature scaling: ECE in-dist closes; ECE shifted barely moves'; two ECE numbers side by side",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "lesson.md",
            "code": "# KEY LESSON\n#\n# Temperature scaling closes the in-distribution ECE gap — the curve\n# moves to the diagonal. But on the shifted slice, ECE barely moves.\n# Calibration on your training distribution does not survive a\n# distribution shift.\n#\n# → two ECE numbers side by side",
            "sparkLine": "Reliability Diagram on Your Own Model, taken apart."
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": ""
          }
        }
      },
