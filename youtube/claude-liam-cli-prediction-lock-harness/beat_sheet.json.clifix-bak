    {
      "beat_id": "B01",
      "act": "PROBLEM — why care",
      "role_note": "the stakes BEFORE the build begins — no terminal yet",
      "narration_text": "You run a probe on your model and write down what you expected afterward. That's not a prediction — it's a reconstruction. The gap between what you predicted and what happened is where the learning lives. Leave the prediction editable and the gap collapses to zero: you learn nothing and the grade knows it. A SHA-256 hash and thirty lines of Python take the edit away.",
      "visual_intent": "title card: 'a prediction you can edit after the result is worth nothing — hash it first'; PROBLEM beat, no terminal yet",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "command": "a prediction you can edit after the result is worth nothing — hash it first",
            "topic": "COMPUTATIONAL SKEPTICISM",
            "segment": "Prediction-Lock Harness, taken apart.",
            "greeting": "",
            "runningText": "framing the problem…",
            "output": [],
