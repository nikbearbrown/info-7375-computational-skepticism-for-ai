    {
      "beat_id": "B06",
      "act": "SUMMARY",
      "role_note": "the lesson — one beat",
      "narration_text": "The information in an audit lives in the gap between prediction and outcome. Leave the prediction editable and the gap collapses to zero — you learn nothing and the grade knows it. The lock is thirty lines of Python and a SHA-256 hash. Wire it as the first step in every probe and it stops being a rule you might forget and becomes a step you can't skip. A surprise you predicted against beats a confirmation you assumed — and you can only know which one you got if the prediction was locked before you looked.",
      "visual_intent": "recap card: 'locked prediction → real gap → real learning'; HASH VERIFIED as the honesty floor",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "lesson.md",
