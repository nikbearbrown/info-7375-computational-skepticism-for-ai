    {
      "beat_id": "B06",
      "act": "SUMMARY",
      "role_note": "the lesson — one beat",
      "narration_text": "The join is the highest-leverage fix in a verified-data pipeline and the cheapest. Normalization moved coverage from sixty-one to eighty-nine without a model, without training data, without an API call. Fuzzy matching proposes — never accepts. The human sign-off is the gate. A join that fabricates a match — auto-accepting a fuzzy score — is worse than one that honestly reports 'Unknown.' Coverage you can't trace is not coverage.",
      "visual_intent": "recap card: 'normalization: 61 → 89; fuzzy: propose, never accept'; the delta number large",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "lesson.md",
