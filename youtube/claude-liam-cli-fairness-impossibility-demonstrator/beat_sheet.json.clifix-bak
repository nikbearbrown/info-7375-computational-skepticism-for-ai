    {
      "beat_id": "B06",
      "act": "SUMMARY",
      "role_note": "the lesson — one beat",
      "narration_text": "When you enforce equalized TPR, PPV diverges: Group A drops to fifty-six percent, Group B rises to seventy-four percent. The model is no longer calibrated. The impossibility is not a bug — it is a theorem. The question for every deployment is: which fairness criterion aligns with the harm you are trying to prevent? That is a legal and ethical decision, not a technical one.",
      "visual_intent": "recap card: 'calibrated vs equalized-TPR — trade-off, not a fix'; impossibility theorem name on screen",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "lesson.md",
            "code": "# KEY LESSON\n#\n# When you enforce equalized TPR, PPV diverges: Group A drops to\n# fifty-six percent, Group B rises to seventy-four percent. The model is\n# no longer calibrated. The impossibility is not a bug — it is a\n# theorem.\n#\n# → impossibility theorem name on screen",
            "sparkLine": "Fairness Impossibility, taken apart."
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": ""
          }
        }
      },
      "estimated_duration_s": 12,
      "audio_file": "mp3/beat-B06.mp3",
      "actual_duration_s": 20.54,
      "build": {
