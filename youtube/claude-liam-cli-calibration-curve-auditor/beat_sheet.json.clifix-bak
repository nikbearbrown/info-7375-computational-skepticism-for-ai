      }
    },
    {
      "beat_id": "B06",
      "act": "SUMMARY",
      "role_note": "the lesson — one beat",
      "narration_text": "Platt scaling wraps the forest in a logistic layer calibrated on a held-out fold. The Brier drops from point-twelve to point-nine. The curve moves to the diagonal. The lesson: calibration is a post-hoc audit, not a training outcome. High AUC is a ranking guarantee, not a probability guarantee. Run the curve before you ship the score.",
      "visual_intent": "recap card: 'AUC ranks, Brier measures truth'; before/after Brier scores side by side",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "lesson.md",
            "code": "# KEY LESSON\n#\n# Platt scaling wraps the forest in a logistic layer calibrated on a\n# held-out fold. The Brier drops from point-twelve to point-nine. The\n# curve moves to the diagonal.\n#\n# → before/after Brier scores side by side",
            "sparkLine": "Calibration Curves, taken apart."
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": ""
          }
        }
      },
      "estimated_duration_s": 12,
      "audio_file": "mp3/beat-B06.mp3",
      "actual_duration_s": 18.56,
      "build": {
        "status": "VIDEO",
        "src": "media/B06.mp4",
        "filled_by": "media",
        "at": "2026-07-19T16:51:20"
      }
    },
