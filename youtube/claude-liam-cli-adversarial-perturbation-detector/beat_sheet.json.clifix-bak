    {
      "beat_id": "B01",
      "act": "PROBLEM — why care",
      "role_note": "the problem, the stakes — BEFORE the CLI",
      "narration_text": "A ResNet-50 trained on ImageNet classifies a golden retriever at ninety-eight percent confidence. Add a perturbation no human eye can detect — pixel noise bounded by epsilon equals point-zero-one — and the same model outputs ostrich at ninety-four percent. The image is unchanged to you. The gradient changed the model's decision surface. Goodfellow's Fast Gradient Sign Method from twenty-fourteen takes one forward pass and one backward pass and breaks any undefended classifier. This video builds the attack and measures what it costs.",
      "visual_intent": "title card: 'epsilon=0.01 — invisible to humans, lethal to classifiers'; PROBLEM beat, no terminal",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeComposerAsk",
          "props": {
            "command": "epsilon=0.01 — invisible to humans, lethal to classifiers",
            "topic": "COMPUTATIONAL SKEPTICISM",
