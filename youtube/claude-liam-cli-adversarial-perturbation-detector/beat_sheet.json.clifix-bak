    {
      "beat_id": "B06",
      "act": "SUMMARY",
      "role_note": "the lesson — one beat",
      "narration_text": "At epsilon equals point-zero-zero-five — noise bounded to half a percent of pixel range — the attack crosses fifty percent on an incorrect class. The model is not seeing the image you are seeing. It is seeing a mathematical structure in pixel space that you cannot perceive. Adversarial robustness is not a hardening question — it is a deployment context question. If your model is in a domain where inputs can be controlled by an adversary, the epsilon budget is your attack surface.",
      "visual_intent": "recap card: epsilon sweep result — attack crossing 50% confidence; 'gradient sees what eyes do not'",
      "shot": {
        "type": "GRAPHIC",
        "source": "remotion",
        "motion": "fade",
        "remotion": {
          "pattern": "ClaudeCodeBeat",
          "props": {
            "title": "lesson.md",
            "code": "# KEY LESSON\n#\n# At epsilon equals point-zero-zero-five — noise bounded to half a\n# percent of pixel range — the attack crosses fifty percent on an\n# incorrect class. The model is not seeing the image you are seeing. It\n# is seeing a mathematical structure in pixel space that you cannot\n# perceive.\n#\n# → gradient sees what eyes do not",
            "sparkLine": "Adversarial Robustness, taken apart."
          },
          "rendered": {
            "out": "media/B06.mp4",
            "at": ""
          }
        }
