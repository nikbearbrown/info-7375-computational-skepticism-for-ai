      "beat_id": "B07",
      "act": "show-tell",
      "lane": "manim",
      "proof_gate": "SHOW",
      "narration_text": "P of A given B equals P of A and B divided by P of B, provided P of B is greater than zero. The numerator is the overlap; the denominator is all of B.",
